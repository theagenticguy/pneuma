        <!-- ===== step shapes (front layer) ===== -->
        <mxCell id="15" value="&lt;b&gt;Compute the legal moves&lt;/b&gt;&lt;br&gt;from the current state &#8212; guards evaluated against process variables." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#233B54;" vertex="1" parent="1">
