        <!-- ===== titles ===== -->
        <mxCell id="2" value="&lt;font style=&quot;font-size:22px&quot;&gt;&lt;b&gt;Propose / Decide &#8212; the agent as an untrusted oracle&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#6B7684&quot;&gt;The engine enumerates and validates. The model only names a choice.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#233B54;" vertex="1" parent="1">
