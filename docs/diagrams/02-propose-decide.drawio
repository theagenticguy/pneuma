        <mxCell id="16" value="&lt;b&gt;Render them as a prompt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-family:monospace;font-size:9px;color:#4A5A6A&quot;&gt;&quot;You are at T06DetermineNecessityOfStopAdvice.&lt;br&gt;Variables: {checked: 1}.&lt;br&gt;Legal moves: &#8230;&lt;br&gt;Answer with exactly one transition name.&quot;&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6C8EBF;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#233B54;" vertex="1" parent="1">
          <mxGeometry x="250" y="274" width="400" height="112" as="geometry"/>
        </mxCell>

        <mxCell id="17" value="&lt;b&gt;VALIDATE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Legal from this state?&lt;br&gt;Guards satisfied?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;fontSize=11;fontColor=#6B5300;" vertex="1" parent="1">
          <mxGeometry x="300" y="435" width="300" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="18" value="&lt;b&gt;ACCEPT &#183; legal&lt;/b&gt;&lt;br&gt;Apply effects &#8594; move to the target state &#8594; re-check &lt;i&gt;every&lt;/i&gt; invariant &#8594; append to the audit log." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#2C4A20;" vertex="1" parent="1">
          <mxGeometry x="140" y="630" width="290" height="140" as="geometry"/>
        </mxCell>

        <mxCell id="19" value="&lt;b&gt;AGENT &#8212; untrusted oracle&lt;/b&gt;&lt;br&gt;Claude Opus 5 &#183; &lt;span style=&quot;font-family:monospace;font-size:10px&quot;&gt;@ai_method&lt;/span&gt;&lt;br&gt;returns typed &lt;span style=&quot;font-family:monospace;font-size:10px&quot;&gt;Choice{transition, reason}&lt;/span&gt;&lt;br&gt;&lt;br&gt;Proposes &lt;b&gt;ONE&lt;/b&gt; transition, by name." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=12;fontSize=11;fontColor=#4A2F5C;" vertex="1" parent="1">
          <mxGeometry x="896" y="152" width="274" height="180" as="geometry"/>
