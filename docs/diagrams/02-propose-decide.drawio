        <!-- validate -> accept -->
        <mxCell id="11" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=classic;endFill=1;strokeColor=#82B366;strokeWidth=3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=10;fontStyle=1;fontColor=#4E7A38;labelBackgroundColor=none;" edge="1" parent="1" source="17" target="18">
