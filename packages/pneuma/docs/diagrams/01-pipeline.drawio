        </mxCell>
        <mxCell id="17" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Hypothesis state machine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;drives the real interpreter with&lt;br&gt;adversarial input; shrinks failures&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=11;fontColor=#333333;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
