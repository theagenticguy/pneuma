        <mxCell id="10" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#6C8EBF&quot;&gt;&lt;b&gt;1 &#183; SOURCE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;receipt.xes&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;public XES event log&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;1,434 permit cases /&lt;br&gt;8,577 events / 27 activities&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#333333;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
