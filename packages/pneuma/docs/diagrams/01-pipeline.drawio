        </mxCell>
        <mxCell id="11" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#6C8EBF&quot;&gt;&lt;b&gt;2 &#183; PARSE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;Polars DataFrame&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;one row per event,&lt;br&gt;timestamps normalised to UTC&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#333333;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="280" y="205" width="190" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="12" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#6C8EBF&quot;&gt;&lt;b&gt;3 &#183; MINE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;Process discovery&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;directly-follows graph&lt;br&gt;threshold = edges walked by&lt;br&gt;&#8805;&#8202;25 distinct cases&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;fontSize=11;fontColor=#333333;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
          <mxGeometry x="520" y="205" width="190" height="110" as="geometry"/>
        </mxCell>

        <!-- ============ CENTRAL ARTIFACT: TYPED IR ============ -->
        <mxCell id="14" value="&lt;i&gt;The model emits DATA, never code.&lt;/i&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;fontColor=#7F6000;" vertex="1" parent="1">
          <mxGeometry x="760" y="110" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="13" value="&lt;font style=&quot;font-size: 10px;&quot; color=&quot;#B07000&quot;&gt;&lt;b&gt;4 &#183; CENTRAL ARTIFACT&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;b style=&quot;font-size: 17px;&quot;&gt;Typed IR (Pydantic)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;11 states&#160;/&#160;20 edges&lt;br&gt;guards&#160;/&#160;invariants&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=3;fontSize=12;fontColor=#333333;verticalAlign=middle;spacingLeft=8;spacingRight=8;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="760" y="175" width="240" height="170" as="geometry"/>
        </mxCell>

        <!-- ============ THREE CONSUMERS ============ -->
        <mxCell id="15" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;TLA+ renderer &#8594; TLC model-checker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;exhausts the bounded state space;&lt;br&gt;returns a counterexample path&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;fontSize=11;fontColor=#333333;verticalAlign=middle;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
