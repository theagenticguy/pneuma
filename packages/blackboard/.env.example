BLACKBOARD_DATABASE_URL=postgresql://blackboard:blackboard@127.0.0.1:5432/blackboard
BLACKBOARD_HOST=127.0.0.1
# The MCP endpoint the team YAMLs dial. 8010 (not 8000) because 8000 is commonly taken by
# another local MCP server. `scripts/serve_blackboard.py` and `mise run mcp` read this; if
# you change it, keep sdlc_team/**/config.yaml in sync.
BLACKBOARD_MCP_PORT=8010
BLACKBOARD_LOG_LEVEL=INFO
# structlog renderer: `console` (pretty, dev) or `json` (one orjson line/event, prod).
BLACKBOARD_LOG_FORMAT=console
BLACKBOARD_ENV=local

# The target repository the SDLC team builds against — set this to run the system on your
# own repo, then `mise run link-target` to materialize the `.target` symlink the producing
# specialists cwd into. (os_env.cwd is parsed verbatim by omnigent, so the target cannot be
# an env var inside the agent YAML — the symlink is the seam. See docs/RUNBOOK.md / ADR-0015.)
BLACKBOARD_TARGET_REPO=/home/lalsaado/workplace/demo_app

# --- Bedrock / model harness configuration (HANDOFF §15A) ---
# The live team runs on PyPI-pinned omnigent 0.5.1 via `mise run team` (uvx-isolated, so the
# local editable fork at ~/workplace/omnigent never shadows it). It executes in-process with
# local inner sandboxes — no managed hosts, no MicroVMs. See README ADR-0010.
AWS_PROFILE=agentic-poc
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

CLAUDE_CODE_USE_BEDROCK=1
ANTHROPIC_DEFAULT_OPUS_MODEL=global.anthropic.claude-opus-4-8

# Optional alternative to the AWS credential chain:
# AWS_BEARER_TOKEN_BEDROCK=

# The one codex agent (implementation_codex_sol) pins its model in its own YAML
# (executor.model: openai.gpt-5.6-sol), so it does NOT depend on the global model default.
# It still needs ~/.codex/config.toml to route to Bedrock:
#   model_provider = "amazon-bedrock"
#   [model_providers.amazon-bedrock.aws] region = "us-east-1"   # match AWS_REGION above

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
